{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkpoint-game-library",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-09-07",
  "assets": {"directory":"./frontend","binding":"ASSETS","run_worker_first":["/games/*","/auth/*"]},
  "d1_databases": [{"binding":"DB","database_name":"checkpoint-games","database_id":"798c8525-9de8-4093-9e96-74035d8f8bbb"}]
}
